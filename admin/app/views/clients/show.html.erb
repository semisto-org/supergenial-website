<%= page_header @client.name do %>
  <%= link_to "+ Heures", new_time_entry_path(client_id: @client.id), class: "button" %>
  <%= link_to "Modifier", edit_client_path(@client), class: "button button--ghost" %>
<% end %>

<p class="lead">
  <%= badge @client.status_label, @client.status %>
  <%= @client.kind_label %>
  <% if @client.vat_number.present? %> · TVA <%= @client.vat_number %><% end %>
  · <%= eur(@client.rate) %>/h
</p>

<section class="grid-2">
  <div class="card">
    <header class="card-header"><h2>Contacts</h2><%= link_to "+ Contact", new_client_contact_path(@client) %></header>
    <ul class="plain">
      <% @client.contacts.each do |contact| %>
        <li>
          <strong><%= contact.full_name %></strong><%= " (#{contact.role})" if contact.role.present? %>
          <%= badge "principal" if contact.primary? %><br>
          <small><%= safe_join([ (mail_to(contact.email) if contact.email.present?), (link_to(contact.phone, "tel:#{contact.phone.delete(' ')}") if contact.phone.present?) ].compact, " · ") %></small>
          <%= link_to "modifier", edit_client_contact_path(@client, contact), class: "muted small" %>
        </li>
      <% end %>
    </ul>
    <% if @client.contacts.empty? %><p class="muted">Aucun contact.</p><% end %>
    <% if @client.invoicing_address_complete? %>
      <p class="muted"><%= @client.street %>, <%= @client.postal_code %> <%= @client.city %>, <%= Country.name(@client.country) %></p>
    <% elsif @client.address.present? %>
      <p class="muted"><%= simple_format(@client.address) %></p>
    <% end %>
  </div>

  <div class="card">
    <header class="card-header"><h2>Facturation</h2></header>
    <dl class="details">
      <dt>Peppol</dt>
      <dd>
        <%= @client.suggested_peppol_id || "–" %>
        <% unless @client.peppol_reachable.nil? %><%= @client.peppol_reachable? ? badge("joignable", "actif") : badge("introuvable", "suspendu") %><% end %>
        <% if can_write? && @client.suggested_peppol_id %>
          <%= button_to "Vérifier", verify_peppol_client_path(@client), class: "link-button small", form_class: "inline-form" %>
        <% end %>
      </dd>
      <dt>E-mail</dt><dd><%= @client.invoicing_email || "–" %></dd>
      <dt>Régime TVA</dt><dd><%= VatRegime.labels[VatRegime.suggest(@client)] %></dd>
    </dl>
    <% if @client.belgian_business? %><p class="hint">Entreprise belge : factures par Peppol uniquement.</p><% end %>
    <% unless @client.invoicing_address_complete? %><p class="hint">Adresse de facturation à compléter (rue, code postal, ville).</p><% end %>
  </div>

  <div class="card">
    <header class="card-header"><h2>Contrats</h2><%= link_to "+ Contrat", new_contract_path(client_id: @client.id) %></header>
    <table>
      <tbody>
        <% @client.contracts.by_due_date.each do |contract| %>
          <tr>
            <td><%= link_to contract, contract %><br><small class="muted"><%= contract.kinds_label %><%= " · #{contract.plan}" if contract.plan %></small></td>
            <td class="num"><%= eur(contract.current_amount) %> <small class="muted"><%= contract.period_label %></small></td>
            <td><%= contract.actif? ? date(contract.next_billing_on) : badge(contract.status_label, contract.status) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @client.contracts.empty? %><p class="muted">Aucun contrat.</p><% end %>
  </div>

  <div class="card">
    <header class="card-header"><h2>Projets</h2><%= link_to "+ Projet", new_project_path(client_id: @client.id) %></header>
    <table>
      <tbody>
        <% @client.projects.order(updated_at: :desc).each do |project| %>
          <tr>
            <td><%= link_to project, project %><br><small class="muted"><%= project.kind_label %> · <%= project.billing_mode_label %></small></td>
            <td><%= badge project.status_label, project.status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @client.projects.empty? %><p class="muted">Aucun projet.</p><% end %>
  </div>

  <div class="card">
    <header class="card-header"><h2>Packs d'heures</h2><%= link_to "+ Pack", new_pack_path(client_id: @client.id) %></header>
    <ul class="plain">
      <% @client.packs.order(purchased_on: :desc).each do |pack| %>
        <li><%= link_to pack.label, pack %> : <%= hours(pack.used_hours) %> / <%= hours(pack.hours) %>, reste <strong><%= hours(pack.remaining_hours) %></strong></li>
      <% end %>
    </ul>
    <% if @client.packs.empty? %><p class="muted">Aucun pack.</p><% end %>
  </div>
</section>

<div class="card">
  <header class="card-header">
    <h2>Dernières prestations</h2>
    <%= link_to "Tout voir", time_entries_path(client_id: @client.id, status: "") %>
  </header>
  <%= render "time_entries/table", time_entries: @time_entries, show_client: false %>
</div>

<div class="card">
  <header class="card-header"><h2>Factures</h2><%= link_to "+ Facture", new_invoice_path(client_id: @client.id) %></header>
  <table>
    <tbody>
      <% @client.invoices.recent.each do |invoice| %>
        <tr>
          <td><%= date(invoice.issued_on) %></td>
          <td><%= link_to invoice, invoice %></td>
          <td class="num"><%= eur(invoice.amount) %></td>
          <td><%= invoice.draft? ? badge("brouillon", "en_attente") : (invoice.paid? ? badge("payée", "facture") : badge("à encaisser", "a_facturer")) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @client.invoices.empty? %><p class="muted">Aucune facture.</p><% end %>
</div>

<% if @client.notes.present? %>
  <div class="card"><h2>Notes</h2><%= simple_format(@client.notes) %></div>
<% end %>

<% if @client.invoices.any? %>
  <p class="muted small">Ce client a des factures : il ne peut pas être supprimé. Passe-le en « Ancien client ».</p>
<% else %>
  <% linked = { "contact" => @client.contacts.size, "projet" => @client.projects.size, "contrat" => @client.contracts.size,
                "pack" => @client.packs.size, "prestation" => @client.time_entries.size }.select { |_, count| count.positive? } %>
  <p><%= link_to "Supprimer ce client", @client, class: "danger", data: { turbo_method: :delete,
        turbo_confirm: "Supprimer #{@client} ?#{" Seront aussi supprimés : #{linked.map { |name, count| pluralize(count, name) }.to_sentence}." if linked.any?} C'est définitif." } %></p>
<% end %>

<%= render "shared/comments", commentable: @client %>
