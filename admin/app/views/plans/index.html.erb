<%= page_header "Abonnements" do %>
  <%= link_to "+ Formule", new_plan_path, class: "button" %>
<% end %>

<div class="card">
  <table>
    <thead><tr><th>Formule</th><th class="num">Prix actuel</th><th>Prochain prix</th><th class="num">Contrats actifs</th><th class="num">Par an</th></tr></thead>
    <tbody>
      <% @plans.each do |plan| %>
        <tr class="<%= 'is-inactive' unless plan.active? %>">
          <td><%= link_to plan, plan %><% unless plan.active? %> <%= badge "retirée" %><% end %>
            <% if plan.description.present? %><br><small class="muted"><%= plan.description %></small><% end %></td>
          <td class="num"><%= eur(plan.current_price) %><br><small class="muted"><%= plan.period_label %></small></td>
          <td><% if (next_price = plan.next_price) %><%= eur(next_price.amount) %> <small class="muted">dès le <%= l(next_price.starts_on) %></small><% else %>–<% end %></td>
          <td class="num"><%= plan.active_contracts.size %></td>
          <td class="num"><%= eur(plan.yearly_revenue) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr><th colspan="3">Total annuel</th><th class="num"><%= @plans.sum { |plan| plan.active_contracts.size } %></th><th class="num"><%= eur(@plans.sum(&:yearly_revenue)) %></th></tr>
    </tfoot>
  </table>
  <% if @plans.empty? %><%= empty_state "Aucune formule.", action: link_to("+ Formule", new_plan_path, class: "button button--ghost") %><% end %>
</div>
