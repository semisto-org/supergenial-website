<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= [ content_for(:title), "Admin Super Génial" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@600&family=Inter:wght@400..700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "layouts/icons" %>
    <div class="app" data-controller="sidebar command-palette" data-command-palette-url-value="<%= search_path %>">
      <%= render "layouts/sidebar" %>
      <div class="sidebar-backdrop" data-action="click->sidebar#close"></div>

      <div class="app__main">
        <div class="mobilebar">
          <button type="button" class="icon-button" aria-label="Ouvrir le menu" aria-controls="sidebar" aria-expanded="false" data-sidebar-target="toggle" data-action="sidebar#toggle"><%= icon "menu" %></button>
          <%= link_to root_path, class: "workspace__home", "aria-label": "Super Génial" do %><span class="brand-logo" aria-hidden="true"></span><% end %>
          <button type="button" class="icon-button mobilebar__search" aria-label="Rechercher" data-action="command-palette#open"><%= icon "search" %></button>
        </div>

        <main class="page">
          <% flash.each do |type, message| %>
            <div class="flash flash--<%= type %>" role="status"><%= message %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
      <%= render "layouts/command_palette" %>
    </div>
  </body>
</html>
