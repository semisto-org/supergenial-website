<%= form_with model: invoice do |f| %>
  <%= render "shared/errors", object: invoice %>
  <%= f.hidden_field :source %>
  <div class="row">
    <%= field f, :client_id, :select, client_options, include_blank: "Choisir…", required: true %>
    <%= field f, :project_id, :select, project_options(invoice.client_id), include_blank: "Aucun" %>
  </div>
  <%= field f, :label, required: true %>
  <% if invoice.admin? %>
    <div class="row">
      <%= field f, :issued_on, :date_field, required: true, hint: "Remplacée par la date d'émission" %>
      <%= field f, :vat_regime, :select, Invoice.vat_regime_options, hint: "Proposé d'après le pays et le n° de TVA du client" %>
    </div>

    <h3>Lignes</h3>
    <div data-controller="invoice-lines">
      <table class="lines-form">
        <thead><tr><th>Description</th><th>Quantité</th><th>Unité</th><th>Prix unitaire HTVA</th><th>TVA</th><th>Période</th><th></th></tr></thead>
        <tbody data-invoice-lines-target="body">
          <%= f.fields_for :lines, include_id: false do |line| %>
            <%= render "line_fields", line: %>
          <% end %>
        </tbody>
      </table>
      <template data-invoice-lines-target="template">
        <%= f.fields_for :lines, InvoiceLine.new(vat_rate: 21, quantity: 1, unit: "unit"), child_index: "NEW_LINE" do |line| %>
          <%= render "line_fields", line: %>
        <% end %>
      </template>
      <p><button type="button" class="button button--ghost button--small" data-action="invoice-lines#add">+ Ajouter une ligne</button></p>
      <p class="hint">Les lignes sans description sont ignorées.</p>
    </div>
  <% else %>
    <div class="row">
      <%= field f, :number %>
      <%= field f, :issued_on, :date_field, required: true %>
      <%= field f, :amount, :number_field, step: "0.01", required: true %>
      <%= field f, :paid_on, :date_field %>
    </div>
  <% end %>
  <%= field f, :notes, :text_area, rows: 2, hint: "Interne, n'apparaît pas sur la facture" %>
  <div class="form-actions">
    <%= f.submit "Enregistrer", class: "button" %>
    <%= link_to "Annuler", invoice.persisted? ? invoice : invoices_path, class: "button button--ghost" %>
  </div>
<% end %>
