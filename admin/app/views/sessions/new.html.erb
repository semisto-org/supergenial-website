<div class="card session-card">
  <h1><span class="brand-logo brand-logo--stacked" role="img" aria-label="Super Admin"></span></h1>
  <% if flash[:alert] %><div class="flash flash--alert"><%= flash[:alert] %></div><% end %>
  <%= form_with url: session_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "E-mail" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password, "Mot de passe" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <%= form.submit "Se connecter", class: "button" %>
  <% end %>
</div>
