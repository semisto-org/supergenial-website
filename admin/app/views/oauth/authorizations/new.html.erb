<div class="card session-card">
  <h1><span class="brand-logo brand-logo--stacked" role="img" aria-label="Super Admin"></span></h1>
  <p class="muted">Autoriser l'accès à l'admin</p>
  <p><strong><%= @client.name %></strong> demande à <%= Current.user.can_write? ? "gérer l'admin en ton nom : lire, créer, modifier et supprimer" : "consulter en ton nom" %> clients, projets, heures, contrats, factures…</p>
  <p class="muted">Connecté en tant que <%= Current.user.email_address %>. Retour vers <strong><%= URI.parse(@params[:redirect_uri]).host %></strong>.</p>
  <%= form_with url: oauth_authorization_path, method: :post do |form| %>
    <% @params.each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>
    <div class="actions">
      <%= form.button "Autoriser", name: "decision", value: "approve", class: "button" %>
      <%= form.button "Refuser", name: "decision", value: "deny", class: "button button--ghost" %>
    </div>
  <% end %>
</div>
