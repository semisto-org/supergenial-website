<% p = @projection %>
<%= page_header "Pilotage fiscal #{@year}" do %>
  <%= link_to "← #{@year - 1}", tax_projection_path(year: @year - 1), class: "button button--ghost" %>
  <%= link_to "#{@year + 1} →", tax_projection_path(year: @year + 1), class: "button button--ghost" %>
  <%= link_to "Paramètres", tax_parameters_path, class: "button button--ghost" %>
<% end %>

<p class="lead">Estimation à discuter avec la comptable, pas une déclaration. Elle suppose que les contrats actifs et les frais fixes continuent jusqu'au 31 décembre.</p>

<% if p.remuneration_needed.positive? %>
  <div class="flash flash--alert">
    Taux réduit perdu avec ce plan : verser encore <strong><%= eur(p.remuneration_needed) %></strong> de rémunération avant le 31 décembre
    pour atteindre <%= eur(p.parameter(:director_min_remuneration), precision: 0) %> ou le bénéfice imposable.
  </div>
<% end %>
<% if TaxParameter.in_force(on: Date.new(@year, 12, 31)).any? { |parameter| !parameter.verified? } %>
  <p class="hint">Certains <%= link_to "paramètres fiscaux", tax_parameters_path %> ne sont pas encore confirmés par la comptable.</p>
<% end %>

<section class="stats">
  <div class="stat">
    <span class="stat__label">Bénéfice imposable estimé</span>
    <strong class="stat__value"><%= eur(p.taxable_profit, precision: 0) %></strong>
  </div>
  <div class="stat">
    <span class="stat__label">Impôt des sociétés</span>
    <strong class="stat__value"><%= eur(p.corporate_tax, precision: 0) %></strong>
    <span class="stat__hint"><%= p.reduced_rate? ? "taux réduit #{percent(p.parameter(:isoc_reduced_rate))}" : "taux normal #{percent(p.parameter(:isoc_standard_rate))}" %></span>
  </div>
  <div class="stat">
    <span class="stat__label">Rémunération du gérant</span>
    <strong class="stat__value"><%= eur(p.remuneration, precision: 0) %></strong>
    <span class="stat__hint"><%= eur(p.remuneration_paid, precision: 0) %> versés · <%= eur(p.remuneration_planned, precision: 0) %> prévus</span>
  </div>
  <div class="stat">
    <span class="stat__label">Versements anticipés</span>
    <strong class="stat__value"><%= eur(p.advance_paid, precision: 0) %></strong>
    <span class="stat__hint"><% if p.advance_shortfall.positive? %>retard de <%= eur(p.advance_shortfall, precision: 0) %><% else %>à jour<% end %></span>
  </div>
</section>

<section class="grid-2">
  <div class="card">
    <h2>Calcul</h2>
    <dl class="details">
      <dt>Chiffre d'affaires</dt><dd><%= eur(p.revenue) %> <small class="muted">(<%= eur(p.revenue_to_date) %> facturés, <%= eur(p.recurring_revenue_ahead) %> de contrats à venir, <%= eur(p.unbilled_work) %> d'heures à facturer)</small></dd>
      <dt>Frais déductibles</dt><dd>− <%= eur(p.costs) %> <small class="muted">(<%= eur(p.costs_to_date) %> d'achats, <%= eur(p.fixed_costs_ahead) %> de frais fixes à venir)</small></dd>
      <dt>Rémunération</dt><dd>− <%= eur(p.remuneration) %></dd>
      <dt>Cotisations sociales</dt><dd>− <%= eur(p.social_contributions) %></dd>
      <dt>PLCI</dt><dd>− <%= eur(p.plci) %> <small class="muted">(plafond <%= eur(p.parameter(:plci_ceiling), precision: 0) %>)</small></dd>
      <dt>Bénéfice imposable</dt><dd><strong><%= eur(p.taxable_profit) %></strong></dd>
      <dt>Impôt</dt><dd><strong><%= eur(p.corporate_tax) %></strong></dd>
    </dl>
  </div>

  <div class="card">
    <h2>Versements anticipés conseillés</h2>
    <table>
      <tbody>
        <% p.advance_payment_schedule.each do |payment| %>
          <tr class="<%= 'is-inactive' if payment[:due_on] < p.today %>"><td><%= date(payment[:due_on]) %></td><td class="num"><%= eur(payment[:amount]) %></td></tr>
        <% end %>
      </tbody>
    </table>
    <p class="hint">Un quart de l'impôt estimé à chaque échéance évite la majoration (<%= percent(p.parameter(:advance_payment_surcharge_rate)) %>). Les paiements sont repris des mouvements bancaires classés « Impôts et précompte ».</p>
  </div>
</section>

<div class="card">
  <h2>Plan <%= @year %></h2>
  <% if can_write? %>
    <%= form_with model: p.plan, url: tax_projection_path(year: @year), method: :patch do |f| %>
      <div class="row">
        <%= field f, :monthly_remuneration, :number_field, step: "0.01", hint: "Brut par mois, pour les mois restants" %>
        <%= field f, :year_end_remuneration, :number_field, step: "0.01", hint: "Versement ponctuel avant le 31 décembre" %>
        <%= field f, :plci_amount, :number_field, step: "0.01", hint: "Prime PLCI de l'année" %>
      </div>
      <%= field f, :notes, :text_area, rows: 2 %>
      <div class="form-actions"><%= f.submit "Recalculer", class: "button" %></div>
    <% end %>
  <% else %>
    <dl class="details">
      <dt>Rémunération mensuelle</dt><dd><%= eur(p.plan.monthly_remuneration) %></dd>
      <dt>Versement de fin d'année</dt><dd><%= eur(p.plan.year_end_remuneration) %></dd>
      <dt>PLCI</dt><dd><%= eur(p.plan.plci_amount) %></dd>
    </dl>
  <% end %>
</div>
